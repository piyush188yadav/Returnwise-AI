# ReturnWise AI - Environment Variables Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Python Machine Learning Service Configuration
# Defaults to http://127.0.0.1:5001 if ML microservice is running,
# or fallback to local python CLI runner automatically
PYTHON_ML_SERVICE_URL=http://127.0.0.1:5001
PYTHON_PATH=python

# AWS Bedrock Configuration (Optional - set credentials only if enabling Bedrock)
# If left empty, ReturnWise AI will automatically use deterministic data-driven local insights
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon S3 Configuration (Optional - for model artifact and dataset backup)
# If left empty, local files in ml/model/ and data/ are used by default
S3_BUCKET_NAME=
S3_REGION=us-east-1
