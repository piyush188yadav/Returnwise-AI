{
  "name": "returnwise-ai",
  "version": "1.0.0",
  "description": "ReturnWise AI - Full-Stack Machine Learning E-Commerce Return Predictor",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
